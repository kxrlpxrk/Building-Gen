{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:building-generator:project:v2",
  "title": "Building Generator BG-02A Project",
  "description": "One orthogonal rectangular or polygon footprint. Coordinates and dimensions are integer millimetres. Runtime validation also checks simple connected rings, right angles, minimum edge lengths, matching outer extents, distinct IDs, and a valid non-collapsing mitered wall inset.",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "name",
    "architecture",
    "createdAt",
    "updatedAt",
    "building"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "\\S"
    },
    "architecture": {
      "enum": ["Medieval", "Norse", "Mixed"]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "building": {
      "type": "object",
      "required": ["id", "sections"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/rectangle"
              },
              {
                "$ref": "#/$defs/polygon"
              }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{1,100}$"
    },
    "positionValue": {
      "type": "integer",
      "minimum": -10000000,
      "maximum": 10000000
    },
    "dimension": {
      "type": "integer",
      "minimum": 500,
      "maximum": 500000,
      "description": "Polygon length/width are validated outer extents, not area. Polygon vertices are authoritative."
    },
    "rectangle": {
      "allOf": [
        {
          "$ref": "#/$defs/sectionBase"
        },
        {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": {
              "const": "rectangle"
            }
          }
        }
      ]
    },
    "sectionBase": {
      "type": "object",
      "required": [
        "id",
        "position",
        "length",
        "width",
        "wallThickness",
        "orientation",
        "floorCount"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "position": {
          "type": "object",
          "required": ["x", "y", "z"],
          "properties": {
            "x": {
              "$ref": "#/$defs/positionValue"
            },
            "y": {
              "$ref": "#/$defs/positionValue"
            },
            "z": {
              "$ref": "#/$defs/positionValue"
            }
          }
        },
        "length": {
          "$ref": "#/$defs/dimension"
        },
        "width": {
          "$ref": "#/$defs/dimension"
        },
        "wallThickness": {
          "type": "integer",
          "minimum": 10,
          "maximum": 249999
        },
        "orientation": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 360
        },
        "floorCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        }
      }
    },
    "polygon": {
      "allOf": [
        {
          "$ref": "#/$defs/sectionBase"
        },
        {
          "type": "object",
          "required": ["kind", "preset", "vertices"],
          "properties": {
            "kind": {
              "const": "polygon"
            },
            "preset": {
              "enum": ["L-shape", "T-shape", "U-shape", "Cross", "Irregular"]
            },
            "vertices": {
              "type": "array",
              "minItems": 4,
              "maxItems": 64,
              "items": {
                "type": "object",
                "required": ["x", "y"],
                "properties": {
                  "x": {
                    "type": "integer",
                    "minimum": -500000,
                    "maximum": 500000
                  },
                  "y": {
                    "type": "integer",
                    "minimum": -500000,
                    "maximum": 500000
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
